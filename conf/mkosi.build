#!/bin/bash
set -euo pipefail

# Install pre-built kernel and modules from /kernel-install (bind-mounted via --build-sources)
KERNEL_SRC="/kernel-install"

if [[ ! -d "$KERNEL_SRC/boot" ]] || [[ ! -d "$KERNEL_SRC/lib/modules" ]]; then
  echo "ERROR: Pre-built kernel not found at $KERNEL_SRC"
  echo "Expected $KERNEL_SRC/boot/ and $KERNEL_SRC/lib/modules/"
  ls -la "$KERNEL_SRC" 2>/dev/null || echo "Directory does not exist"
  exit 1
fi

# Copy kernel image and related files
mkdir -p "$DESTDIR/boot"
cp -a "$KERNEL_SRC/boot/"* "$DESTDIR/boot/"

# Copy modules
mkdir -p "$DESTDIR/lib/modules"
cp -a "$KERNEL_SRC/lib/modules/"* "$DESTDIR/lib/modules/"
